# Copy to .env.local for local development. Never commit real secrets.
# Browser-facing origin. Never use 0.0.0.0 or the container's internal port.
# Railway falls back to its injected RAILWAY_PUBLIC_DOMAIN when this is invalid/unset.
APP_BASE_URL=http://localhost:3000
DEPLOY_BASIC_AUTH_ENABLED=false
DEPLOY_BASIC_AUTH_USER=
DEPLOY_BASIC_AUTH_PASSWORD=
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
# KYC provider: didit | fastlane-test (fastlane-test chỉ dùng local/staging)
KYC_PROVIDER=didit
# Mock result: approved | declined | review
FASTLANE_TEST_KYC_RESULT=approved
# Explicit non-production admin shortcuts. Production always ignores this flag.
ENABLE_DEPOSIT_DEBUG_ACTIONS=false

# Optional distributed cache. The app falls back to Supabase when unavailable.
REDIS_URL=redis://localhost:6379

# Contract-signing OTP. Use at least 32 random characters. AUTH0_SECRET is the
# fallback key material when CONTRACT_OTP_SECRET is omitted.
CONTRACT_OTP_SECRET=replace-with-a-random-32-byte-secret
# Local-only OTP console output when no email provider is configured.
ENABLE_OTP_EMAIL_LOGGING=false
RESEND_API_KEY=
OTP_EMAIL_FROM=Fastlane <no-reply@example.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Sentry error and performance monitoring.
NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=replace-with-source-map-upload-token
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Read-only token used by the Admin monitoring dashboard. Never expose as NEXT_PUBLIC_*.
SENTRY_MONITORING_TOKEN=replace-with-read-only-sentry-token
SENTRY_MONITORING_ENVIRONMENT=development

# VNPay sandbox
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=replace-with-vnpay-tmn-code
VNPAY_HASH_SECRET=replace-with-vnpay-hash-secret
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay/return
VNPAY_IPN_URL=https://your-public-domain.example/api/v1/payments/vnpay/ipn

# Service-to-service token used by the 5-minute unsigned-document expiry job.
# Configure the same value as GitHub secret CONTRACT_EXPIRY_CRON_SECRET.
CRON_SECRET=replace-with-a-long-random-service-token

# Auth0 application (Universal Login / browser session)
AUTH0_SECRET=replace-with-a-random-32-byte-secret
AUTH0_DOMAIN=your-tenant.region.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
# Optional dedicated key for encrypted deposit drafts in Redis. Use at least
# 32 random characters. AUTH0_SECRET is used as separated key material when omitted.
DEPOSIT_DRAFT_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret

# Auth0 API (bearer access tokens)
AUTH0_AUDIENCE=https://api.fastlane.local
AUTH0_ISSUER_BASE_URL=https://your-tenant.region.auth0.com/
AUTH0_JWKS_URI=https://your-tenant.region.auth0.com/.well-known/jwks.json
AUTH0_ROLE_CLAIM=https://fastlane.example.com/roles

# Managed Supabase project (not started by Docker Compose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Optional exact release-ID confirmation for the after-sales apply command.
# This is not a credential; keep the service-role key server-side regardless.
AFTER_SALES_PUBLISH_RELEASE_ID=

# After-sales snapshot managed browsers. Bright Data Browser API is the default; Browserless/Browserbase are fallbacks.
# Tokens/keys must stay server-side.
BRIGHTDATA_BROWSER_WS_ENDPOINT=
BRIGHTDATA_BROWSER_USERNAME=
BRIGHTDATA_BROWSER_PASSWORD=
BRIGHTDATA_FORCE_RETRY=false
BRIGHTDATA_QUOTA_RETRY_HOURS=24
AFTER_SALES_REMOTE_WORKER_INTERVAL_HOURS=12
AFTER_SALES_REMOTE_WORKER_SINGLE_RUN=false
AFTER_SALES_REMOTE_WORKER_RAW_RECAPTURE=true
AFTER_SALES_ACQUISITION_FORCE_EXIT=false
BROWSERLESS_API_TOKEN=
BROWSERLESS_CDP_ENDPOINT=wss://production-sfo.browserless.io/chromium/stealth
BROWSERLESS_PROXY=
BROWSERLESS_PROXY_COUNTRY=
BROWSERLESS_PROXY_STICKY=true
BROWSERLESS_PROXY_LOCALE_MATCH=true
BROWSERLESS_SESSION_TIMEOUT_MS=180000
BROWSERLESS_COOLDOWN_HOURS=12
BROWSERLESS_QUOTA_RETRY_HOURS=24
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_QUOTA_RETRY_HOURS=24
LOCAL_PLAYWRIGHT_EXECUTABLE_PATH=

# Global assistant search uses the deterministic rule engine only.

# Sales Agent provider registry. The admin stores only these variable names;
# secret values stay in the deployment environment and are never persisted in DB.
SALES_AGENT_ENABLED=false
SALES_AGENT_HARNESS_ENABLED=false
SALES_AGENT_INTERACTIONS_ENABLED=false
SALES_AGENT_INTERACTION_METRICS_ENABLED=false
SALES_AGENT_DEBUG_LOGS_ENABLED=false
SALES_AGENT_DEBUG_LOG_FILE=
SALES_AGENT_INTERACTION_SECRET=
SALES_AGENT_OPENAI_MODEL=gpt-5.6-luna
SALES_AGENT_OPENAI_REASONING_EFFORT=low
NEXT_PUBLIC_SALES_AGENT_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
