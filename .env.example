# Copy to .env.local for local development. Never commit real secrets.
APP_BASE_URL=http://localhost:3000

# Optional distributed cache. The app falls back to Supabase when unavailable.
REDIS_URL=redis://localhost:6379

# Sentry error and performance monitoring.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_ENVIRONMENT=production-v2
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production-v2
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_MONITORING_TOKEN=
SENTRY_MONITORING_ENVIRONMENT=production-v2

#VNPay
