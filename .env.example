# Copy to .env.local for local development. Never commit real secrets.
# Browser-facing origin. Never use 0.0.0.0 or the container's internal port.
# Railway falls back to its injected RAILWAY_PUBLIC_DOMAIN when this is invalid/unset.
APP_BASE_URL=http://localhost:3000
DEPLOY_BASIC_AUTH_ENABLED=false
DEPLOY_BASIC_AUTH_USER=
DEPLOY_BASIC_AUTH_PASSWORD=
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=

# Optional distributed cache. The app falls back to Supabase when unavailable.
REDIS_URL=redis://localhost:6379

# Sentry error and performance monitoring.
NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=replace-with-source-map-upload-token
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Read-only token used by the Admin monitoring dashboard. Never expose as NEXT_PUBLIC_*.
SENTRY_MONITORING_TOKEN=replace-with-read-only-sentry-token
SENTRY_MONITORING_ENVIRONMENT=development

# VNPay sandbox
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_TMN_CODE=replace-with-vnpay-tmn-code
VNPAY_HASH_SECRET=replace-with-vnpay-hash-secret
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay/return
VNPAY_IPN_URL=https://your-public-domain.example/api/v1/payments/vnpay/ipn

# Auth0 application (Universal Login / browser session)
AUTH0_SECRET=replace-with-a-random-32-byte-secret
AUTH0_DOMAIN=your-tenant.region.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
# Optional dedicated key for encrypted deposit drafts in Redis. Use at least
# 32 random characters. AUTH0_SECRET is used as separated key material when omitted.
DEPOSIT_DRAFT_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret

# Auth0 API (bearer access tokens)
AUTH0_AUDIENCE=https://api.fastlane.local
AUTH0_ISSUER_BASE_URL=https://your-tenant.region.auth0.com/
AUTH0_JWKS_URI=https://your-tenant.region.auth0.com/.well-known/jwks.json
AUTH0_ROLE_CLAIM=https://fastlane.example.com/roles

# Managed Supabase project (not started by Docker Compose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudinary Media Storage (optional, file upload for products)
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@<your_cloud_name>

# Optional global assistant search (server-only)
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini
ASSISTANT_LLM_EXTRACTION_ENABLED=false
ASSISTANT_SEARCH_ENABLED=false
ASSISTANT_LLM_TIMEOUT_MS=3500
