{
  "name": "fastlane",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:openapi": "npm --prefix api-contract run check:openapi",
    "bundle:openapi": "npm --prefix api-contract run bundle",
    "preview:openapi": "npm --prefix api-contract run preview",
    "verify": "npm test && npm run typecheck && npm run check:openapi && npm run build"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.25.0",
    "@radix-ui/react-slot": "latest",
    "@supabase/server": "^1.4.0",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "framer-motion": "^12.42.2",
    "jose": "6.2.3",
    "lucide-react": "latest",
    "next": "15.5.20",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.10.0",
    "tailwind-merge": "latest",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "latest",
    "postcss": "8.5.20",
    "tailwindcss": "^3.4.17",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  }
}
